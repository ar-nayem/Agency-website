generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  password    String
  role        String   @default("AGENT")
  isActive    Boolean  @default(true)
  phone       String?
  wechat      String?
  avatar      String?
  bio         String?
  canViewPortals Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  managedByAdminId String?
  managedByAdmin    User?   @relation("AdminManagesAgents", fields: [managedByAdminId], references: [id])
  managedAgents     User[]  @relation("AdminManagesAgents")

  students        Student[]
  uploadedDocs    Document[]      @relation("UploadedBy")
  activityLogs    ActivityLog[]
  sentMessages    Message[]       @relation("SentBy")
  receivedMessages Message[]      @relation("ReceivedBy")
  organization    OrganizationProfile?
  transactions      Transaction[] @relation("AgentTransactions")
  createdTransactions Transaction[] @relation("TransactionCreatedBy")
  universityPortals UniversityPortal[]
}

model Student {
  id                        String   @id @default(uuid())
  serialNumber              String?  @unique
  
  // Personal Information
  passportFamilyName        String
  givenName                 String
  fullName                  String
  photo                     String?
  gender                    String
  chineseName               String?
  maritalStatus             String
  religion                  String
  occupation                String
  employerInstitution       String?
  nationality               String
  dateOfBirth               String
  yearsInHomeCountry        String?
  countryOfBirth            String
  wechat                    String?
  placeOfBirth              String
  chineseDescent            String   @default("No")
  currentlyInChina          String   @default("No")
  
  // Correspondence Address
  homeAddress               String?
  detailedAddress           String
  cityProvince              String
  country                   String
  zipcode                   String
  phoneMobile               String
  mainEmail                 String
  
  // Passport & Visa
  passportNo                String
  passportExpiryDate        String
  oldPassportNo             String?
  oldPassportExpiry         String?
  
  // China Study Experience
  studiedInChina            String   @default("No")
  visaType                  String?
  chinaInstitution          String?
  visaExpiryDate            String?
  studyInChinaFrom          String?
  studyInChinaTo            String?
  
  // Program applied for
  programApplied            String?
  
  status                    String   @default("PENDING")
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  agentId         String
  agent           User            @relation(fields: [agentId], references: [id])
  documents       Document[]
  educationHistory EducationHistory[]
  workExperience   WorkExperience[]
  familyMembers    FamilyMember[]
  financialSponsors FinancialSponsor[]
  messages         Message[]
  transactions     Transaction[]
  portalSnapshots  PortalStudentSnapshot[]
}

model EducationHistory {
  id           String   @id @default(uuid())
  degree       String
  schoolName   String
  yearFrom     String
  yearTo       String
  contactPerson String?
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model WorkExperience {
  id           String   @id @default(uuid())
  yearFrom     String
  yearTo       String
  company      String
  occupation   String
  reference    String?
  phone        String?
  email        String?
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id           String   @id @default(uuid())
  name         String
  relationship String
  nationality  String
  employer     String?
  occupation   String?
  phone        String?
  email        String?
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FinancialSponsor {
  id           String   @id @default(uuid())
  name         String
  relationship String
  nationality  String
  employer     String?
  occupation   String?
  phone        String?
  email        String?
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Document {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  type         String
  category     String   @default("OTHER")
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation("UploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model Message {
  id             String    @id @default(uuid())
  content        String    @default("")
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  senderId    String
  sender      User      @relation("SentBy", fields: [senderId], references: [id])
  receiverId  String
  receiver    User      @relation("ReceivedBy", fields: [receiverId], references: [id])
  studentId   String?
  student     Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model DocumentRequirement {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  description String?
  accept      String   @default(".pdf,image/*")
  type        String   @default("PDF")
  maxSize     String?
  isRequired  Boolean  @default(false)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model FieldRequirement {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  section     String
  isRequired  Boolean  @default(true)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model OrganizationProfile {
  id             String   @id @default(uuid())
  name           String
  logo           String?
  email          String?
  phone          String?
  wechat         String?
  address        String?
  website        String?
  description    String?
  welcomeMessage String?
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Transaction {
  id              String   @id @default(uuid())
  type            String   // INCOME | EXPENSE
  category        String
  amount          Float
  currency        String   @default("CNY")
  paymentMethod   String?
  status          String   @default("COMPLETED") // COMPLETED | PENDING | REFUNDED
  description     String?
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  agentId         String
  agent           User     @relation("AgentTransactions", fields: [agentId], references: [id])

  createdById     String
  createdBy       User     @relation("TransactionCreatedBy", fields: [createdById], references: [id])

  @@index([agentId])
  @@index([studentId])
}

model UniversityPortal {
  id             String    @id @default(uuid())
  name           String
  loginUrl       String
  username       String
  passwordEnc    String
  platform       String    @default("AT0086")
  isActive       Boolean   @default(true)
  lastScanAt     DateTime?
  lastScanStatus String?
  lastScanError  String?
  lastScanCount  Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  students PortalStudentSnapshot[]
  changes  PortalStatusChangeLog[]
}

model PortalStudentSnapshot {
  id           String   @id @default(uuid())
  externalId   String
  passportNo   String?
  passportName String?
  program      String?
  applyStatus  String?
  admitStatus  String?
  raw          String?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portalId String
  portal   UniversityPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  matchedStudentId String?
  matchedStudent   Student? @relation(fields: [matchedStudentId], references: [id])

  @@unique([portalId, externalId])
  @@index([passportNo])
}

model PortalStatusChangeLog {
  id           String   @id @default(uuid())
  externalId   String
  passportName String?
  passportNo   String?
  field        String
  oldValue     String?
  newValue     String?
  detectedAt   DateTime @default(now())

  portalId String
  portal   UniversityPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
}

model ScanSettings {
  id                String    @id @default("global")
  intervalHours     Int       @default(5)
  enabled           Boolean   @default(true)
  lastRunAt         DateTime?
  // Portals are scanned one at a time, never in one batch — this marks when
  // the last individual portal scan kicked off, so the next one waits out
  // the stagger gap instead of firing immediately alongside it.
  lastPortalScanAt  DateTime?
  staggerMinutes    Int       @default(5)
}

model VisitorLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String?
  userEmail String?
  userRole  String?
  path      String
  referrer  String?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([path])
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
